export UV_PROJECT_ENVIRONMENT=$SCRATCH/venvs/$(basename $PWD)
export UV_LINK_MODE=copy
export UV_TOOL_DIR="$SCRATCH/.uv/tools"
export UV_TOOL_BIN_DIR="$SCRATCH/.uv/tools/bin"   # optional but tidy
export XDG_CACHE_HOME="$SCRATCH/.cache"           # uvx’s ephemeral envs live here
export UV_PYTHON_INSTALL_DIR="$SCRATCH/.uv/py"    # if uv manages Python
export UV_PYTHON_CACHE_DIR="$SCRATCH/.uv/py_cache"
